{
  "routes": [
    { "route": "/api/health", "allowedRoles": ["anonymous"] },
    { "route": "/api/reminders/run", "allowedRoles": ["anonymous"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/app/*", "allowedRoles": ["authenticated"] },
    { "route": "/select-organization", "allowedRoles": ["authenticated"] },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/login", "allowedRoles": ["anonymous"] },
    { "route": "/access-denied", "allowedRoles": ["anonymous"] },
    { "route": "/logout", "redirect": "/.auth/logout?post_logout_redirect_uri=/login" }
  ],
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*", "/*.{css,js,png,jpg,jpeg,svg,ico,webp,woff2}"] },
  "responseOverrides": {
    "401": { "redirect": "/login", "statusCode": 302 },
    "403": { "rewrite": "/index.html", "statusCode": 200 }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; script-src 'self'; connect-src 'self' https://*.blob.core.windows.net; img-src 'self' data: blob: https://*.blob.core.windows.net; style-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://login.microsoftonline.com",
    "strict-transport-security": "max-age=31536000",
    "referrer-policy": "strict-origin-when-cross-origin",
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "permissions-policy": "camera=(), microphone=(), geolocation=()"
  },
  "platform": { "apiRuntime": "node:22" },
  "mimeTypes": { ".json": "application/json" }
}
